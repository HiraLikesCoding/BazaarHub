# ------------------------------------------------------------------
# Client (Next.js) environment variables
# Copy this file to "client/.env.local" and adjust the values.
# Only NEXT_PUBLIC_* variables are ever exposed to the browser.
# ------------------------------------------------------------------

# Project URL: Supabase dashboard -> Project Settings -> API -> Project URL
# Plain origin only - do NOT append /rest/v1 or any path.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable (anon) key: same page, under "Project API keys".
# Starts with "sb_publishable_" or is the legacy anon JWT (eyJ...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# The service_role / secret key is NOT a browser variable and never belongs
# in this file for the app itself. It is only read by the seed script:
#   npm run seed:supabase   (set SUPABASE_SERVICE_ROLE_KEY in the environment
#   or add it to this gitignored file temporarily, then remove it)
