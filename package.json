{
  "name": "bazaarhub",
  "version": "1.0.0",
  "private": true,
  "description": "BazaarHub - full-stack e-commerce platform (Next.js + Express + MongoDB)",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev:memory": "npm run dev:memory --prefix server",
    "seed": "npm run seed --prefix server",
    "images": "npm run images --prefix server",
    "test": "npm test --prefix server",
    "lint": "npm run lint --prefix client",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix client"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
