# ------------------------------------------------------------------
# BazaarHub environment variables (template)
# Copy this file to "server/.env" (and client/.env.local for the frontend)
# and fill in your own values. NEVER commit the real .env file.
# ------------------------------------------------------------------

# ----------------------------- SERVER ------------------------------
# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/bazaarhub

# Secret used to sign JSON Web Tokens. Use a long random string.
JWT_SECRET=change_me_to_a_long_random_secret_string

# Secret used to hash passwords (extra layer of security)
BCRYPT_SALT_ROUNDS=12

# Port the Express API runs on
PORT=5000

# Comma separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:3000

# ----------------------------- CLIENT ------------------------------
# Base URL of the backend API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5000
