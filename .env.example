# ------------------------------------------------------------------
# BazaarHub environment variables (template)
# Copy the CLIENT block to "client/.env.local" and fill in your own
# values. NEVER commit the real .env file.
# ------------------------------------------------------------------

# ----------------------------- CLIENT ------------------------------
# Supabase project: dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Only needed to run the seed script (never in the browser):
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
